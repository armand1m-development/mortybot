{
  "imports": {
    "/": "./",
    "./": "./",
    "@std/crypto": "jsr:@std/crypto@1.1.0",
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",
    "@std/encoding/base64": "jsr:@std/encoding@1.0.11/base64",
    "@std/encoding/hex": "jsr:@std/encoding@1.0.11/hex",
    "@std/fmt/colors": "jsr:@std/fmt@1.0.10/colors",
    "@std/http/file-server": "jsr:@std/http@1.1.3/file-server",
    "@std/log": "jsr:@std/log@0.224.14",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/media-types": "jsr:@std/media-types@1.1.0",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/path/posix": "jsr:@std/path@1.1.6/posix",
    "@std/yaml": "jsr:@std/yaml@1.1.2",
    "@formatjs/icu-messageformat-parser": "npm:@formatjs/icu-messageformat-parser@3.5.16",
    "@grammyjs/auto-retry": "npm:@grammyjs/auto-retry@2.0.2",
    "@grammyjs/files": "npm:@grammyjs/files@1.2.0",
    "@grammyjs/router": "npm:@grammyjs/router@2.0.0",
    "@grammyjs/runner": "npm:@grammyjs/runner@2.0.3",
    "@grammyjs/storage-file": "npm:@grammyjs/storage-file@2.6.0",
    "dutch-tax-income-calculator": "npm:dutch-tax-income-calculator@26.1.3",
    "grammy": "npm:grammy@1.45.1",
    "grammy/types": "npm:grammy@1.45.1/types",
    "intl-messageformat": "npm:intl-messageformat@11.2.13",
    "linkedom": "npm:linkedom@0.18.13",
    "mathjs": "npm:mathjs@15.2.0",
    "oak": "jsr:@oak/oak@17.2.0",
    "outdent": "npm:outdent@0.8.0",
    "playwright-core": "npm:playwright-core@1.62.1",
    "querystring": "node:querystring",
    "sentry": "npm:@sentry/deno@10.69.0",
    "sharp": "npm:sharp@0.35.3",
    "ts-pattern": "npm:ts-pattern@5.9.0"
  },
  "nodeModulesDir": "auto",
  "allowScripts": [
    "npm:sharp@0.35.3"
  ],
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "fmt": {
    "exclude": [
      ".github/ISSUE_TEMPLATE/",
      ".github/workflows/codeql-analysis.yml",
      "docker-compose.yml",
      "src/i18n/translations.generated.ts"
    ]
  },
  "tasks": {
    "start": "deno run --allow-all ./main.ts",
    "dev": "deno run --watch --allow-all ./main.ts",
    "watch": "deno task dev",
    "check": "deno check main.ts generators/*.ts src/**/*.ts",
    "test": "deno test --allow-read --allow-env --allow-ffi --allow-sys",
    "test:coverage": "deno test --allow-read --allow-env --allow-ffi --allow-sys --coverage=coverage && deno coverage --lcov --output=coverage.lcov coverage",
    "check:generated": "deno run --allow-read ./generators/generateSkillsFile.ts --check",
    "check:i18n": "deno run --allow-read ./generators/generateTranslationsFile.ts --check",
    "verify": "deno fmt --check && deno lint && deno task check:generated && deno task check:i18n && deno task check && deno task test",
    "generate:skills": "deno run --allow-write --allow-read ./generators/generateSkillsFile.ts",
    "generate:i18n": "deno run --allow-write --allow-read ./generators/generateTranslationsFile.ts",
    "generate:skills:readme": "deno run --allow-write --allow-read --allow-ffi --allow-net --allow-env --allow-sys ./generators/generateReadmeSkillsFile.ts"
  }
}
